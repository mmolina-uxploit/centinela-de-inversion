{
  "name": "centinela-de-inversion",
  "version": "0.1.0",
  "description": "Infraestructura de defensa financiera: detecta agotamiento de stock vs. velocidad de gasto publicitario y emite alerta crítica para detener pauta.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:dry": "CENTINELA_DRY_RUN=true tsx src/index.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
